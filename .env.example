# 이 파일을 복사해서 .env로 저장한 뒤 실제 값을 채우세요.
# .env는 절대 git/공개 저장소에 커밋하지 마세요.
# 각 항목 발급 방법은 SETUP.md를 참고하세요.

# --- Gemini (자료조사 + 표지 배경 이미지 생성) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Claude / Anthropic (콘텐츠 생성) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# "api_key"(기본) 또는 "oauth"(Claude Pro/Max 구독 사용량 - 로컬 전용, 먼저
# `pip install claude-agent-sdk` 후 `claude setup-token`으로 한 번 로그인해둘 것.
# docs/SETUP.md 2-b 참고. oauth면 위 ANTHROPIC_API_KEY는 비워둬도 됨)
CLAUDE_AUTH_MODE=api_key
# CLAUDE_AUTH_MODE=oauth일 때만 필요. `claude setup-token` 실행 시 출력되는 토큰 값을
# 그대로 붙여넣을 것 - claude 로그인 세션에 자동 저장되는 게 아니라 이 환경변수로 직접
# 전달해야 스크립트(claude-agent-sdk)가 인식한다.
CLAUDE_CODE_OAUTH_TOKEN=
